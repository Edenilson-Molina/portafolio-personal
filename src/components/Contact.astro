---
// Contact.astro: Professional contact channels and direct message form
---

<section class="w-full flex flex-col gap-6" id="contacto">
  <div class="flex flex-col gap-1.5">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs uppercase tracking-widest text-primary-fixed-dim font-medium">
        05 // Conexión Profesional
      </span>
      <div class="h-px w-10 bg-white/20"></div>
    </div>
    <h2 class="font-display text-2xl sm:text-3xl font-bold text-white tracking-tight">
      Iniciemos un Proyecto de Alto Impacto
    </h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
    <!-- Contact Information & Channels (5 cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between gap-6 p-6 sm:p-7 rounded-3xl bg-[#13151f]/75 backdrop-blur-xl border border-white/[0.07] shadow-xl">
      <div class="flex flex-col gap-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 self-start">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="font-mono text-xs text-emerald-400 font-medium">Disponibilidad Inmediata</span>
        </div>
        <h3 class="font-display text-xl font-semibold text-white">Canales de Contacto Directo</h3>
        <p class="text-sm text-neutral-300 leading-relaxed">
          Abierto a propuestas de ingeniería en Machine Learning, automatización con modelos generativos y desarrollo de sistemas empresariales.
        </p>

        <div class="flex flex-col gap-2.5 mt-2">
          <!-- Email -->
          <a class="flex items-center gap-3.5 p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.06] hover:border-white/[0.15] transition-all group" href="mailto:elmeredenilsonrosalesmolina@gmail.com">
            <span class="material-symbols-outlined text-primary text-[22px]">email</span>
            <div class="flex flex-col min-w-0">
              <span class="text-[11px] font-mono text-neutral-400">Correo Electrónico</span>
              <span class="text-xs text-neutral-200 font-mono truncate group-hover:text-white transition-colors">
                elmeredenilsonrosalesmolina@gmail.com
              </span>
            </div>
          </a>

          <!-- Phone / WhatsApp -->
          <a class="flex items-center gap-3.5 p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.06] hover:border-white/[0.15] transition-all group" href="tel:+50370289034">
            <span class="material-symbols-outlined text-emerald-400 text-[22px]">call</span>
            <div class="flex flex-col min-w-0">
              <span class="text-[11px] font-mono text-neutral-400">Teléfono / WhatsApp</span>
              <span class="text-xs text-neutral-200 font-mono group-hover:text-white transition-colors">
                +503 7028 9034
              </span>
            </div>
          </a>

          <!-- LinkedIn -->
          <a class="flex items-center gap-3.5 p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.06] hover:border-white/[0.15] transition-all group" href="https://linkedin.com/in/eermolina" rel="noopener noreferrer" target="_blank">
            <span class="material-symbols-outlined text-secondary text-[22px]">work</span>
            <div class="flex flex-col min-w-0">
              <span class="text-[11px] font-mono text-neutral-400">LinkedIn Perfil</span>
              <span class="text-xs text-neutral-200 font-mono group-hover:text-white transition-colors">
                linkedin.com/in/eermolina
              </span>
            </div>
          </a>

          <!-- GitHub -->
          <a class="flex items-center gap-3.5 p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.06] hover:border-white/[0.15] transition-all group" href="https://github.com/Edenilson-Molina" rel="noopener noreferrer" target="_blank">
            <span class="material-symbols-outlined text-neutral-300 text-[22px]">terminal</span>
            <div class="flex flex-col min-w-0">
              <span class="text-[11px] font-mono text-neutral-400">GitHub Perfil</span>
              <span class="text-xs text-neutral-200 font-mono group-hover:text-white transition-colors">
                github.com/Edenilson-Molina
              </span>
            </div>
          </a>
        </div>
      </div>

      <div class="pt-3 flex items-center justify-between text-xs font-mono text-neutral-400 border-t border-white/[0.06]">
        <span>Zona Horaria: UTC-6 (CST)</span>
        <span class="text-emerald-400">Activo hoy</span>
      </div>
    </div>

    <!-- Contact Form (7 cols) -->
    <div class="lg:col-span-7 p-6 sm:p-7 rounded-3xl bg-[#13151f]/75 backdrop-blur-xl border border-white/[0.07] shadow-xl flex flex-col justify-between gap-5">
      <div class="flex flex-col gap-1">
        <h3 class="font-display text-xl font-semibold text-white">Enviar un Mensaje Directo</h3>
        <p class="text-xs text-neutral-400">
          Completa el formulario para consultas sobre consultoría técnica, pipelines de IA o contrataciones.
        </p>
      </div>

      <form class="flex flex-col gap-3.5" id="contactForm">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <!-- Name Input -->
          <div class="flex flex-col gap-1">
            <label class="font-mono text-[11px] text-neutral-400 uppercase" for="name">
              Nombre Completo *
            </label>
            <input 
              class="px-3.5 py-2.5 rounded-xl bg-white/[0.03] text-white placeholder:text-neutral-500 border border-white/[0.08] focus:outline-none focus:border-white/30 focus:ring-1 focus:ring-white/20 text-sm shadow-inner" 
              id="name" 
              placeholder="Ej. Ing. Carlos Rodríguez" 
              required 
              type="text"
            />
          </div>

          <!-- Email Input -->
          <div class="flex flex-col gap-1">
            <label class="font-mono text-[11px] text-neutral-400 uppercase" for="email">
              Correo de Contacto *
            </label>
            <input 
              class="px-3.5 py-2.5 rounded-xl bg-white/[0.03] text-white placeholder:text-neutral-500 border border-white/[0.08] focus:outline-none focus:border-white/30 focus:ring-1 focus:ring-white/20 text-sm shadow-inner" 
              id="email" 
              placeholder="ejemplo@empresa.com" 
              required 
              type="email"
            />
          </div>
        </div>

        <!-- Subject / Project Scope -->
        <div class="flex flex-col gap-1">
          <label class="font-mono text-[11px] text-neutral-400 uppercase" for="subject">
            Tipo de Proyecto / Asunto
          </label>
          <select 
            class="px-3.5 py-2.5 rounded-xl bg-[#141620] text-neutral-200 border border-white/[0.08] focus:outline-none focus:border-white/30 focus:ring-1 focus:ring-white/20 text-sm shadow-inner cursor-pointer" 
            id="subject"
          >
            <option value="rag">Arquitectura RAG &amp; Optimización de Modelos</option>
            <option value="edge">Edge AI &amp; Visión Computacional</option>
            <option value="software">Desarrollo de Software Fullstack / Backend</option>
            <option value="hiring">Oportunidad Laboral / Contratación</option>
            <option value="other">Otro asunto / Colaboración</option>
          </select>
        </div>

        <!-- Message Input -->
        <div class="flex flex-col gap-1">
          <label class="font-mono text-[11px] text-neutral-400 uppercase" for="message">
            Detalles del Mensaje *
          </label>
          <textarea 
            class="px-3.5 py-2.5 rounded-xl bg-white/[0.03] text-white placeholder:text-neutral-500 border border-white/[0.08] focus:outline-none focus:border-white/30 focus:ring-1 focus:ring-white/20 text-sm shadow-inner resize-none" 
            id="message" 
            placeholder="Describe brevemente el alcance del proyecto o propuesta técnica..." 
            required 
            rows="4"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button 
          class="group inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-primary-container to-[#d61336] text-white font-medium text-sm tracking-wide shadow-[0_6px_20px_rgba(255,82,94,0.3)] hover:shadow-[0_8px_28px_rgba(255,82,94,0.5)] hover:-translate-y-0.5 transition-all cursor-pointer" 
          type="submit"
        >
          <span>Transmitir Mensaje</span>
          <span class="material-symbols-outlined text-[18px] transition-transform duration-300 group-hover:translate-x-1">send</span>
        </button>
      </form>

      <!-- Feedback notification container -->
      <div class="hidden p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center gap-2.5 text-sm" id="successFeedback">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span>¡Mensaje recibido con éxito! Elmer responderá en un plazo máximo de 24 horas hábiles.</span>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const feedback = document.getElementById('successFeedback');
  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      feedback.classList.remove('hidden');
      form.reset();
      setTimeout(() => {
        feedback.classList.add('hidden');
      }, 7000);
    });
  }
</script>
