---
// Contact.astro: Canales directos de conexión profesional
---

<section class="w-full flex flex-col gap-6" id="contacto">
  <div class="flex flex-col gap-1.5">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs uppercase tracking-widest text-primary-fixed-dim font-medium">
        05 // Conexión Profesional
      </span>
      <div class="h-px w-10 bg-white/20"></div>
    </div>
    <h2 class="font-display text-2xl sm:text-3xl font-bold text-white tracking-tight">
      Iniciemos un Proyecto de Alto Impacto
    </h2>
  </div>

  <div class="w-full p-6 sm:p-8 rounded-3xl bg-[#13151f]/75 backdrop-blur-xl border border-white/[0.07] shadow-xl flex flex-col gap-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex flex-col gap-1">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 self-start">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="font-mono text-xs text-emerald-400 font-medium">Disponibilidad Inmediata</span>
        </div>
        <h3 class="font-display text-xl font-semibold text-white mt-1">Canales de Contacto Directo</h3>
        <p class="text-sm text-neutral-300 max-w-2xl leading-relaxed">
          Abierto a propuestas de ingeniería en Machine Learning, automatización de procesos con IA y desarrollo de sistemas empresariales escalables.
        </p>
      </div>

      <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-xs font-mono text-neutral-400 self-start sm:self-auto">
        <span class="text-emerald-400">&bull;</span>
        <span>Zona Horaria: UTC-6 (CST) &bull; Activo hoy</span>
      </div>
    </div>

    <!-- 4 Direct Channels in a clean responsive grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 pt-2">
      <!-- Email -->
      <a class="flex flex-col justify-between p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.06] hover:border-white/[0.18] transition-all group" href="mailto:elmeredenilsonrosalesmolina@gmail.com">
        <div class="flex items-center justify-between mb-3">
          <span class="p-2 rounded-xl bg-white/[0.04] text-primary border border-white/[0.06] material-symbols-outlined text-[20px]">email</span>
          <span class="material-symbols-outlined text-neutral-500 group-hover:text-white transition-colors text-[18px]">arrow_outward</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-[11px] font-mono text-neutral-400">Correo Electrónico</span>
          <span class="text-xs text-neutral-200 font-mono truncate group-hover:text-white transition-colors mt-0.5">
            elmeredenilsonrosalesmolina@gmail.com
          </span>
        </div>
      </a>

      <!-- Phone / WhatsApp -->
      <a class="flex flex-col justify-between p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.06] hover:border-white/[0.18] transition-all group" href="tel:+50370289034">
        <div class="flex items-center justify-between mb-3">
          <span class="p-2 rounded-xl bg-white/[0.04] text-emerald-400 border border-white/[0.06] material-symbols-outlined text-[20px]">call</span>
          <span class="material-symbols-outlined text-neutral-500 group-hover:text-white transition-colors text-[18px]">arrow_outward</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-[11px] font-mono text-neutral-400">Teléfono / WhatsApp</span>
          <span class="text-xs text-neutral-200 font-mono group-hover:text-white transition-colors mt-0.5">
            +503 7028 9034
          </span>
        </div>
      </a>

      <!-- LinkedIn -->
      <a class="flex flex-col justify-between p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.06] hover:border-white/[0.18] transition-all group" href="https://linkedin.com/in/eermolina" rel="noopener noreferrer" target="_blank">
        <div class="flex items-center justify-between mb-3">
          <span class="p-2 rounded-xl bg-white/[0.04] text-secondary border border-white/[0.06] material-symbols-outlined text-[20px]">work</span>
          <span class="material-symbols-outlined text-neutral-500 group-hover:text-white transition-colors text-[18px]">arrow_outward</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-[11px] font-mono text-neutral-400">LinkedIn Perfil</span>
          <span class="text-xs text-neutral-200 font-mono group-hover:text-white transition-colors mt-0.5">
            linkedin.com/in/eermolina
          </span>
        </div>
      </a>

      <!-- GitHub -->
      <a class="flex flex-col justify-between p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.06] hover:border-white/[0.18] transition-all group" href="https://github.com/Edenilson-Molina" rel="noopener noreferrer" target="_blank">
        <div class="flex items-center justify-between mb-3">
          <span class="p-2 rounded-xl bg-white/[0.04] text-neutral-300 border border-white/[0.06] material-symbols-outlined text-[20px]">terminal</span>
          <span class="material-symbols-outlined text-neutral-500 group-hover:text-white transition-colors text-[18px]">arrow_outward</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-[11px] font-mono text-neutral-400">GitHub Perfil</span>
          <span class="text-xs text-neutral-200 font-mono group-hover:text-white transition-colors mt-0.5">
            github.com/Edenilson-Molina
          </span>
        </div>
      </a>
    </div>
  </div>
</section>
