---
// Skills.astro: Bento grid showing core competencies across 4 technical domains with interactive spotlight & tactile reactive pills
---

<section class="w-full flex flex-col gap-6 relative" id="habilidades">
  <!-- Ambient Prismatic Aura behind section -->
  <div
    class="absolute -top-10 left-1/2 -translate-x-1/2 w-4/5 h-40 bg-gradient-to-r from-cyan-500/5 via-purple-500/5 to-emerald-500/5 blur-3xl pointer-events-none -z-10"
  >
  </div>

  <!-- Section Header -->
  <div class="flex flex-col gap-1.5">
    <div class="flex items-center gap-2">
      <span
        class="font-mono text-xs uppercase tracking-widest text-primary-fixed-dim font-medium"
      >
        03 // Competencias Principales
      </span>
      <div class="h-px w-10 bg-white/20"></div>
    </div>
    <h2
      class="font-display text-2xl sm:text-3xl font-bold text-white tracking-tight"
    >
      Habilidades Técnicas Especializadas
    </h2>
  </div>

  <!-- 4-Card Bento Grid with Dynamic Spotlight -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Category 1: IA & Datos (Cyan Aura) -->
    <div
      class="skill-spotlight-card group relative p-6 sm:p-7 rounded-2xl bg-[#131520]/80 backdrop-blur-xl border border-white/[0.08] shadow-[0_10px_30px_rgba(0,0,0,0.4)] flex flex-col gap-5 hover:border-cyan-500/30 hover:-translate-y-1.5 transition-all duration-300 overflow-hidden"
      style="--spotlight-color: rgba(56, 189, 248, 0.14);"
    >
      <!-- Top Luminous Edge Highlight -->
      <div
        class="absolute top-0 left-6 right-6 h-[1.5px] bg-gradient-to-r from-transparent via-cyan-400/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
      >
      </div>

      <!-- Spotlight Radial Cursor Layer -->
      <div
        class="pointer-events-none absolute -inset-px rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-0"
        style="background: radial-gradient(350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), var(--spotlight-color), transparent 70%);"
      >
      </div>

      <!-- Category Header -->
      <div class="relative z-10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div
            class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/25 text-cyan-400 flex items-center justify-center shadow-[0_0_15px_rgba(56,189,248,0.15)] group-hover:shadow-[0_0_25px_rgba(56,189,248,0.4)] group-hover:scale-105 transition-all duration-300"
          >
            <span class="material-symbols-outlined text-[22px]">psychology</span
            >
          </div>
          <span
            class="font-display text-base font-semibold text-white group-hover:text-cyan-200 transition-colors"
          >
            IA y Datos
          </span>
        </div>
      </div>

      <!-- Skill Pills -->
      <div class="relative z-10 flex flex-wrap gap-2">
        <span
          class="group/pill inline-flex items-center gap-1.5 font-mono text-xs px-3 py-1.5 rounded-lg bg-white/[0.03] text-neutral-300 border border-white/[0.07] hover:bg-cyan-500/[0.12] hover:border-cyan-400/40 hover:text-white hover:shadow-[0_4px_12px_rgba(56,189,248,0.18)] hover:-translate-y-0.5 transition-all duration-200 cursor-default select-none"
