---
// Hero.astro: Ethereal 3D Prismatic Hero with tactile buttons and geometric crystal balance
const baseUrl = import.meta.env.BASE_URL;
---

<section class="w-full pt-8 lg:pt-14 flex flex-col gap-10 relative" id="inicio">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Left Column: Identity & Bio (7 cols) -->
    <div class="lg:col-span-7 flex flex-col gap-6">
      
      <!-- Live Telemetry Status Pill -->
      <div class="inline-flex items-center gap-2 self-start px-3.5 py-1.5 rounded-full bg-white/[0.04] backdrop-blur-xl border border-white/[0.09] shadow-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
        </span>
        <span class="font-mono text-xs text-neutral-300 tracking-wide">
          Fractal Neural Systems &bull; Listo para despliegue
        </span>
      </div>

      <!-- Main Name & Title -->
      <div class="flex flex-col gap-2">
        <span class="font-mono text-xs uppercase tracking-widest text-primary-fixed-dim font-medium">
          Machine Learning &bull; Software Engineering &bull; 2026
        </span>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.08]">
          Elmer Edenilson <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-[#dcfdff] to-primary-container">
            Rosales Molina
          </span>
        </h1>
        
        <div class="mt-2 flex items-center flex-wrap gap-2 text-sm">
          <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-neutral-200 font-medium">
            Software Engineer
          </span>
          <span class="text-neutral-500 font-mono text-xs">//</span>
          <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-secondary font-medium">
            Machine Learning &amp; Process Automation
          </span>
        </div>
      </div>

      <!-- Abstract Bio -->
      <p class="font-body-lg text-neutral-300 max-w-2xl text-[17px] leading-relaxed">
        Egresado de <strong class="text-white font-medium">Ingeniería de Sistemas Informáticos</strong> (Universidad de El Salvador) especializado en Inteligencia Artificial aplicada, arquitecturas <span class="text-secondary font-medium">RAG</span>, Visión Computacional en el Edge y microservicios escalables de alto rendimiento para el sector público y privado.
      </p>

      <!-- Tactile White Pill CTAs (Inspired by Fractal Matter "Discover Now") -->
      <div class="flex flex-wrap items-center gap-3.5 pt-2">
        <a 
          class="btn-tactile-white inline-flex items-center gap-2 px-7 py-3 rounded-full text-sm font-semibold tracking-wide" 
          href="#proyectos"
        >
          <span>Explorar Proyectos</span>
          <span class="material-symbols-outlined text-[19px]">arrow_forward</span>
        </a>
        <a 
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/[0.05] hover:bg-white/[0.1] text-white font-medium text-sm border border-white/[0.1] hover:-translate-y-0.5 backdrop-blur-md transition-all shadow-sm" 
          href="#contacto"
        >
          <span class="material-symbols-outlined text-[19px] text-cyan-400">forum</span>
          <span>Contactar Directo</span>
        </a>
        <a 
          class="inline-flex items-center gap-1.5 px-4 py-3 rounded-full bg-white/[0.03] hover:bg-white/[0.07] text-neutral-300 hover:text-white font-medium text-sm border border-white/[0.06] transition-all" 
          href="mailto:elmeredenilsonrosalesmolina@gmail.com?subject=Solicitud%20de%20CV%20-%20Elmer%20Rosales"
        >
          <span class="material-symbols-outlined text-[18px]">article</span>
          <span>Descargar CV</span>
        </a>
      </div>

      <!-- Micro Terminal Metadata Banner -->
      <div class="rounded-2xl bg-[#0c0e14]/90 backdrop-blur-md p-3.5 px-4 flex flex-wrap items-center justify-between gap-2 border border-white/[0.07] shadow-inner max-w-xl">
        <div class="flex items-center gap-2 font-mono text-xs text-neutral-400">
          <span class="material-symbols-outlined text-cyan-400 text-[16px]">terminal</span>
          <span class="truncate">elmer@neural:~$ infer-benchmark --model bert-qa --quant int8</span>
        </div>
        <span class="font-mono text-[11px] text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded font-medium">
          0.06s Latency
        </span>
      </div>
    </div>

    <!-- Right Column: Crystal Prismatic Capsule & Portrait (5 cols) -->
    <div class="lg:col-span-5 flex flex-col items-center justify-center relative">
      
      <!-- Ambient Prismatic Caustic Halo -->
      <div class="absolute w-80 h-80 rounded-full bg-gradient-to-tr from-cyan-500/20 via-purple-500/15 to-rose-500/15 blur-3xl pointer-events-none"></div>

      <!-- Orbital Graphic Ring -->
      <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
        <div class="w-88 h-88 rounded-full border border-white/[0.08] border-dashed animate-[spin_60s_linear_infinite]"></div>
      </div>

      <!-- Crystal Portrait Frame -->
      <div class="relative p-2.5 rounded-[32px] bg-[#12141e]/80 backdrop-blur-2xl border border-white/[0.12] shadow-[0_20px_50px_rgba(0,0,0,0.6)]">
        <div class="relative overflow-hidden rounded-[24px] bg-[#0c0d12] w-72 sm:w-80 aspect-[4/5] group">
          <img 
            alt="Elmer Edenilson Rosales Molina" 
            class="w-full h-full object-cover object-center filter contrast-[1.03] group-hover:scale-105 transition-transform duration-700" 
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuCkqxfO8gEMMphq9o8STm__n29Rt7hhfmyxenqJoyAHn7sVcGK3oXX20AysLQsIdJvFsvP22QBXkNU57sT7jyjVyHpzbUaR7vtw4nn07UDrfH6VNAILEPS6ABKMuUD7gWLMbKgm-UiGoPgW_PxIEackyS3NILNEfLHL8rGoV51woGbWoUbF8VF8thJg9NQV2ywzcMOU5GCTyHoIT3SgP0V_G2YZNsr6ExCTSWOlKBF4pv7Lr_oSNjTcdRQzjpNOvl1d"
            onerror={`this.onerror=null; this.src='${baseUrl}perfil.jpeg';`}
          />
          
          <!-- Subtle vignette overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#0e1017] via-transparent to-transparent opacity-65 pointer-events-none"></div>

          <!-- Prismatic Floating Badge -->
          <div class="absolute bottom-3 left-3 right-3 p-3 rounded-2xl bg-[#141620]/90 backdrop-blur-2xl border border-white/[0.1] shadow-xl flex items-center justify-between gap-2">
            <div class="flex items-center gap-2.5">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </span>
              <div class="flex flex-col">
                <span class="text-xs font-semibold text-white tracking-tight">Disponible para proyectos</span>
                <span class="font-mono text-[10px] text-neutral-400">Ingeniería &bull; Research &bull; SV</span>
              </div>
            </div>
            <span class="material-symbols-outlined text-cyan-400 text-[20px]">verified</span>
          </div>
        </div>
      </div>

      <!-- Bottom Specs Indicator -->
      <div class="mt-4 flex items-center gap-3 text-neutral-400 font-mono text-xs">
        <div class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px] text-cyan-400">memory</span>
          <span>Edge AI &bull; RAG</span>
        </div>
        <span class="text-neutral-600">/</span>
        <div class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px] text-purple-400">school</span>
          <span>UES Alumni</span>
        </div>
      </div>
    </div>
  </div>
</section>
