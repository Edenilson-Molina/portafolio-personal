---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectsArc from '../components/ProjectsArc.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
---

<Layout
  title="Elmer Edenilson Rosales Molina // ML & Software Engineer"
  description="Portafolio profesional de Elmer Edenilson Rosales Molina: Software Engineer especializado en Machine Learning, arquitecturas RAG, Visión Computacional en el Edge y microservicios escalables."
>
  <div class="relative z-10 w-full max-w-7xl mx-auto px-margin-mobile lg:px-margin flex flex-col gap-16 sm:gap-20 pb-28">
    <Hero />
    <ProjectsArc />
    <Experience />
    <Skills />
    <Education />
    <Contact />
  </div>
</Layout>
